# Ad-hoc probe scripts pointing at the DEAD Railway host (capweb-production-*).
# Kept on disk, out of git: a stale URL in-repo is what sent an operator to the
# wrong host mid-incident once already. Delete them once the migration lands.
/apps/web/_login-loop-test.mjs
/apps/web/_probe-dashboard.mjs

# Raw agent prompt/output dumps — scratch, not project history. One of them
# (_codex-embed310.output) contains a cleartext admin password (since rotated);
# committing any of these would put a credential in git history permanently.
/docs/_codex-*

# Local scratch from the 2026-08-03/04 session: soak timestamp, one-off import
