# =====================================================================
#  Ustoz (data365) — environment template
#
#  THIS FILE IS THE AUTHORITATIVE MANIFEST of every variable the app reads.
#  If you add a new `process.env.X` in the code, add it here too — this file
#  is what someone standing the app up on a new server works from.
#
#  Copy to `.env` for local dev. For production the values live in the
#  COOLIFY UI (your app → Environment Variables) — and a copy of every secret
#  belongs in your PASSWORD MANAGER, because Coolify is on the same server you
#  are trying to survive the loss of.
#
#  Account-agnostic: every value here is a PLACEHOLDER. Generate your OWN
#  secrets (commands below) — never reuse someone else's, and never commit a
#  real value to this file.
#
#  🔴 LOSING `DATABASE_ENCRYPTION_KEY` PERMANENTLY DESTROYS ENCRYPTED DATA.
#     It is not recoverable from a database backup — the backup is encrypted
#     with it. Put it in the password manager before you need it.
#
#  Standing the app up somewhere new: see docs/MIGRATION.md
# =====================================================================

# ---------------------------------------------------------------------
# 1) CORE SECRETS  — generate fresh, keep private
#    NEXTAUTH_SECRET / INVITE_TOKEN_SECRET:  openssl rand -base64 32
#    DATABASE_ENCRYPTION_KEY / CRON_SECRET:  openssl rand -hex 32
# ---------------------------------------------------------------------
NEXTAUTH_SECRET=__GENERATE__base64_32
DATABASE_ENCRYPTION_KEY=__GENERATE__hex_32      # encrypts stored creds; NEVER change after first deploy or data becomes unreadable
INVITE_TOKEN_SECRET=__GENERATE__base64_32
CRON_SECRET=__GENERATE__hex_32                  # must be the SAME value here and in the GitHub Actions secrets

# ---------------------------------------------------------------------
# 2) PUBLIC URL  — all three are the SAME value (your deployed URL).
#    ⚠️ NEXT_PUBLIC_WEB_URL is BUILD-TIME: it is baked into the build,
#       so it MUST be set BEFORE the first build/deploy.
# ---------------------------------------------------------------------
NEXTAUTH_URL=https://your-app.example.com
WEB_URL=https://your-app.example.com
NEXT_PUBLIC_WEB_URL=https://your-app.example.com

# ---------------------------------------------------------------------
# 3) DATABASE (MySQL)
#    A mysql:// connection string. In Coolify this is the database service's
#    INTERNAL host — it is not reachable from outside the server, which is why
#    the nightly backup runs ON the server (deploy/server/backup-db.sh).
#    For one-off `db:push` / `seed:admin` from your laptop you need a route in
#    (an SSH tunnel, or run the command on the server).
# ---------------------------------------------------------------------
DATABASE_URL=mysql://user:password@host:3306/dbname

# ---------------------------------------------------------------------
# 4) STORAGE — Cloudflare R2  (videos, thumbnails, transcripts)
#    ⚠️ KNOWN GOTCHA (cost us a live outage): the server-side S3 client
#       reads CAP_AWS_* from process.env DIRECTLY. The CLOUDFLARE_R2_* ->
#       CAP_AWS_* convenience mapping does NOT reach process.env, so if you
#       set only CLOUDFLARE_R2_*, playback/thumbnails/transcription 500.
#       => SET THE CAP_AWS_* VARS EXPLICITLY (below). Setting both is fine.
#    ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ---------------------------------------------------------------------
CAP_AWS_ACCESS_KEY=__YOUR_R2_ACCESS_KEY__
CAP_AWS_SECRET_KEY=__YOUR_R2_SECRET_KEY__
CAP_AWS_ENDPOINT=https://__YOUR_ACCOUNT_ID__.r2.cloudflarestorage.com
CAP_AWS_BUCKET=__YOUR_BUCKET_NAME__
CAP_AWS_REGION=auto
S3_PATH_STYLE=true
# Optional duplicates (used by the validated env object / other code paths):
CLOUDFLARE_R2_ACCOUNT_ID=__YOUR_ACCOUNT_ID__
CLOUDFLARE_R2_ACCESS_KEY=__YOUR_R2_ACCESS_KEY__
CLOUDFLARE_R2_SECRET_KEY=__YOUR_R2_SECRET_KEY__
CLOUDFLARE_R2_BUCKET=__YOUR_BUCKET_NAME__
# Optional: split endpoints. Set these only if the server should reach storage
# over a different address than browsers do (e.g. a local network endpoint).
# Both default to CAP_AWS_ENDPOINT when unset. `/api/health` reports which is used.
# S3_INTERNAL_ENDPOINT=
# S3_PUBLIC_ENDPOINT=
# Optional: public base URL of the bucket, if you serve objects from one.
# CLOUDFLARE_R2_PUBLIC_URL=

# ---------------------------------------------------------------------
# 5) FIRST ADMIN  — used once by `pnpm seed:admin`. Change the password
#    after the first login.
# ---------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@your-domain.com
INITIAL_ADMIN_PASSWORD=__STRONG_PASSWORD__

# ---------------------------------------------------------------------
# 6) AI  — Gemini (transcription + summary + chapters + RAG chat)
#    Get a key: https://aistudio.google.com/app/apikey
#    Also set an account-level spend cap in Google AI Studio.
# ---------------------------------------------------------------------
GEMINI_API_KEY=__YOUR_GEMINI_KEY__
# Optional: a SECOND Gemini key on a billing-OFF project. When set, transcription
# and summary/refine try it first (gemini-3.5-flash, recorded at $0) and fall back
# to the paid key above. Leave UNSET to always use the paid key.
# GEMINI_API_KEY_FREE=
# Optional: an OpenRouter key (sk-or-v1-...). When set, the PAID leg — and only the
# paid leg — of transcription / summary / translation / chat runs through OpenRouter
# instead of the paid Gemini key above. The FREE Google chain is unchanged and still
# runs FIRST, so nothing here can cause a paid call while free quota is available.
# OPENROUTER_API_KEY=
# Optional: authenticates the scheduled GitHub-Actions crons (recover-stale-ai-jobs
# and poll-batch-jobs). Must match the repo's CRON_SECRET Actions secret.
# CRON_SECRET=
# Optional: enables ElevenLabs Scribe timing-transfer for long videos. Leave UNSET
# to disable (transcription keeps Gemini's own timings). Use a freshly ROTATED key
# only — never the value that was exposed in a tracked planning doc.
# ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------
# 7) BUILD FLAG  — required for the Docker/standalone build.
#    ⚠️ BUILD-TIME: set BEFORE the first build.
# ---------------------------------------------------------------------
NEXT_PUBLIC_DOCKER_BUILD=true

# ---------------------------------------------------------------------
# 8) MEDIA DELIVERY (optional CDN)  — apps/web/lib/media-cdn.ts
#    Set BOTH or NEITHER. When both are set, media is served as signed URLs
#    through a Cloudflare Worker in front of R2 instead of presigned S3 URLs.
#    When either is missing the code returns null and falls back to presigned
#    S3 URLs — so leaving these unset is a safe no-op.
#    ⚠️ MEDIA_SIGNING_SECRET must match the secret deployed in the Worker, and
#       must be carried across unchanged on a server move or existing signed
#       links break.
# ---------------------------------------------------------------------
# MEDIA_CDN_URL=https://media.your-domain.com
# MEDIA_SIGNING_SECRET=__GENERATE__hex_32

# ---------------------------------------------------------------------
# 9) OPS ALERTS (optional)  — apps/web/lib/ops-alert.ts
#    Both required to actually send. If either is missing the app logs the
#    alert to the console and carries on — it never throws.
#    Get the chat id: message @userinfobot on Telegram.
#    NOTE the uptime alert workflow reads TELEGRAM_ALERT_CHAT_ID from the
#    GitHub Actions secrets, not from here — set it in BOTH places.
# ---------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=__YOUR_BOT_TOKEN__
# TELEGRAM_ALERT_CHAT_ID=__YOUR_CHAT_ID__

# ---------------------------------------------------------------------
# 10) BROWSER EXTENSION  — apps/web/app/api/utils.ts
#    The exact origin of the packed Chrome extension, used to allow its
#    cross-origin API calls. Format: chrome-extension://<EXTENSION_ID>
#    Unset = extension origins are not specially allowed.
# ---------------------------------------------------------------------
# CAP_BROWSER_EXTENSION_ORIGIN=chrome-extension://__YOUR_EXTENSION_ID__

# ---------------------------------------------------------------------
# 11) LIMITS / TUNING (optional — all have safe defaults in code)
#    STORAGE_QUOTA_BYTES_PER_ORG : default per-org storage cap in BYTES. Only
#      applies to orgs with quota enforcement switched on; a per-org value in
#      the database overrides it. (apps/web/lib/storage-quota.ts)
#    NEXT_PUBLIC_USD_TO_UZS : display-only FX rate for prices. Default 12900.
#      ⚠️ BUILD-TIME (NEXT_PUBLIC_*) — baked in at build.
#    FFMPEG_PATH : absolute path to an ffmpeg binary. Already set to
#      /usr/bin/ffmpeg inside the Dockerfile — only needed for local dev.
#    NEXT_PUBLIC_DEVELOPER_DASHBOARD_ALLOWED_EMAILS : comma-separated emails
#      that see the developer dashboard nav item. ⚠️ BUILD-TIME.
# ---------------------------------------------------------------------
# STORAGE_QUOTA_BYTES_PER_ORG=
# NEXT_PUBLIC_USD_TO_UZS=12900
# FFMPEG_PATH=
# NEXT_PUBLIC_DEVELOPER_DASHBOARD_ALLOWED_EMAILS=

# ---------------------------------------------------------------------
# 11a) VISIBILITY DEFAULT for new recordings
#    true  = every new recording is link-accessible immediately (no login
#            needed to watch via the share link). OWNER DECISION 2026-07-18:
#            this deployment sets true — sharing by link is the primary flow.
#    false = new recordings are private until shared from the dashboard.
#    Runtime var (not build-time). Unset = false (safe default for other
#    deployments). Existing rows are never touched by this flag.
# ---------------------------------------------------------------------
CAP_VIDEOS_DEFAULT_PUBLIC=true

# ---------------------------------------------------------------------
# 12) OPTIONAL  — leave UNSET unless you actually use them.
#    GOOGLE_CLIENT_ID / SECRET : enable "Sign in with Google".
#    ⚠️ Do NOT set NEXT_PUBLIC_IS_CAP — it turns on billing/paywall gates.
#    Unused upstream integrations (safe to ignore): STRIPE_*, TINYBIRD_*,
#    POSTHOG_*, VERCEL_*, CLOUDFRONT_*, DEEPGRAM/OPENAI/GROQ/REPLICATE,
#    DUB_API_KEY, DISCORD_*_WEBHOOK_URL, SUPERMEMORY_*, MEDIA_SERVER_*,
#    NEXT_PUBLIC_META_PIXEL_ID, NEXT_PUBLIC_GOOGLE_AW_ID, AWS_DEFAULT_PROFILE.
#    Referenced by real code but unset in this deployment (all no-op when unset):
#      AXIOM_TOKEN / AXIOM_DATASET        -> log shipping (instrumentation.ts)
#      NEXT_PUBLIC_GOOGLE_PICKER_API_KEY  -> Google Drive import picker
#    Supplied by the runtime, never set by hand: NODE_ENV, PATH, CI, NEXT_RUNTIME.
# ---------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
